# ---- Database (server-only) ----
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---- BetterAuth (server-only; generate with: openssl rand -base64 32) ----
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8443"

# ---- App URL (public) ----
NEXT_PUBLIC_APP_URL="http://localhost:8443"
APP_URL="http://localhost:8443"

# ---- LLM provider (server-only) ----
# Groq is OpenAI-compatible: https://api.groq.com/openai/v1
GROQ_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TIMEOUT_MS="30000"

# ---- OAuth social providers (optional; feature disabled when empty) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- File storage (server-only) ----
UPLOAD_DIR=".data/uploads"

# ---- Seed behavior ----
# When "true", seed also creates demo users and user-owned fixture data.
SEED_DEMO_DATA="false"
